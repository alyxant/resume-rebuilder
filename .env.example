# Choose gemini or anthropic and provide the matching API key.
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-key

# Required in production. Share this password with trusted users; it protects
# the site and server-side AI endpoints from unauthorized Gemini usage.
APP_PASSWORD=replace-with-a-long-random-password

# Railway: attach a volume at /data and uncomment this value.
# DATA_DIR=/data

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# ANTHROPIC_API_KEY=replace-with-your-key
# ANTHROPIC_MODEL=claude-opus-5
# AI_TIMEOUT_MS=180000
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
